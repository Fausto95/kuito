{
  "name": "kuito",
  "version": "0.0.1",
  "description": "Kuito: a TypeScript-first native UI framework on Hermes",
  "keywords": [
    "android",
    "hermes",
    "ios",
    "native",
    "signals",
    "typescript",
    "ui",
    "uikit"
  ],
  "homepage": "https://github.com/Fausto95/kuito#readme",
  "bugs": {
    "url": "https://github.com/Fausto95/kuito/issues"
  },
  "license": "MIT",
  "author": "Faustino Kialungila",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fausto95/kuito.git"
  },
  "bin": {
    "kuito": "./bin/kuito.js"
  },
  "files": [
    "bin",
    "scripts/kuito.ts",
    "scripts/dev-device.ts",
    "src",
    "native",
    "!native/android/.gradle",
    "!native/android/.kotlin",
    "!native/android/**/build",
    "!native/android/app/.cxx",
    "!native/android/local.properties",
    "!native/ios/*.xcodeproj",
    "!native/ios/App/Info.plist",
    "!native/ios/App/Resources/*.js",
    "!native/android/app/src/main/assets/kuito",
    "templates",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/ui/index.ts",
    "./config": "./src/cli/kuito-config.ts",
    "./tests": "./src/tests/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vp test run",
    "build:device-assets": "cd demo && node ../scripts/build-device-assets.ts",
    "kuito": "node scripts/kuito.ts",
    "demo:build": "cd demo && node ../scripts/build-device-assets.ts",
    "demo:ios": "npm --prefix demo run ios --",
    "demo:android": "npm --prefix demo run android --",
    "lint": "vp lint --deny-warnings",
    "fmt": "vp fmt",
    "docs:coverage": "npm --prefix apps/website run coverage:check",
    "docs:snippets": "npm --prefix apps/website run snippets:check",
    "check": "vp check",
    "generate": "node scripts/generate-protocol.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && vp fmt CHANGELOG.md && npm install --package-lock-only --no-audit --no-fund",
    "release": "changeset publish"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "ink": "8.0.0",
    "magic-string": "1.4.3",
    "oxc-parser": "0.154.0",
    "react": "19.3.1",
    "rolldown": "1.2.14",
    "ws": "8.22.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/ws": "8.18.2",
    "@wasm-fmt/clang-format": "21.1.8",
    "ink-testing-library": "4.0.0",
    "kuito": "file:.",
    "lodash-es": "4.17.21",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
